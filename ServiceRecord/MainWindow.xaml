<Window x:Class="ServiceRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="居服紀錄表" Width="1560" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextBrush}"
        Icon="Assets/app.ico"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <!-- 表格最右邊的刪除鈕 -->
        <DataTemplate x:Key="DeleteCellTemplate">
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="DeleteItem_Click"
                    ToolTip="從這個月刪除這個項目" Focusable="False"/>
        </DataTemplate>

        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="LeftText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CountText" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <Style x:Key="WeekendCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{DynamicResource WeekendBrush}"/>
        </Style>
        <Style x:Key="TotalCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="{DynamicResource TotalBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,12,20,10" LayoutTransform="{DynamicResource UiScale}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 上方：月份切換 + 主要按鈕 ===== -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="PrevMonth_Click" ToolTip="上個月" AutomationProperties.Name="上個月" Padding="10,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;"/>
                </Button>
                <TextBlock x:Name="MonthText" Text="2026 年 6 月" FontFamily="{StaticResource DisplayFont}"
                           FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" MinWidth="150"
                           TextAlignment="Center"/>
                <Button Style="{StaticResource GhostButton}" Click="NextMonth_Click" ToolTip="下個月" AutomationProperties.Name="下個月" Padding="10,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;"/>
                </Button>
                <Button Content="本月" Click="ThisMonth_Click" Margin="8,0,0,0" Padding="12,6"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Import_Click" AutomationProperties.Name="匯入 Excel" Margin="0,0,8,0" ToolTip="讀入原本的 Excel 服務紀錄表">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,8,0"/>
                        <TextBlock Text="匯入 Excel"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Export_Click" AutomationProperties.Name="匯出 Excel" Margin="0,0,8,0" ToolTip="把這個月匯出成服務紀錄表 Excel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" Margin="0,0,8,0"/>
                        <TextBlock Text="匯出 Excel"/>
                    </StackPanel>
                </Button>
                <Button Click="Settings_Click" AutomationProperties.Name="設定" ToolTip="個案、服務項目、比例">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0"/>
                        <TextBlock Text="設定"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 中間：左側個案清單 + 右側服務紀錄表 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="個案" Style="{StaticResource FieldLabel}" Margin="6,2,0,8"/>
                    <ListBox x:Name="ClientList" Grid.Row="1" Style="{StaticResource EntryListStyle}"
                             SelectionChanged="ClientList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0">
                                        <Run Text="實領"/>
                                        <Run Text="{Binding NetPayText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoClientHint" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                               FontSize="13" Margin="6,4" Visibility="Collapsed"
                               Text="這個月還沒有個案。&#x0a;&#x0a;按右上角「設定」新增個案，或用「匯入 Excel」讀入原本的服務紀錄表。"/>

                    <Border Grid.Row="2" Background="{DynamicResource AccentGradient}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="本月月薪" Foreground="#E0E7FF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MonthlyPayText" Text="0" Foreground="White" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="RatioHintText" Foreground="#E0E7FF" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ClientTitle" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0"
                                       Text="點格子直接打數字，Enter 往下一格；選好格子按 + / − 加減一次，Delete 清除。"/>
                        </StackPanel>
                        <CheckBox x:Name="UsedOnlyBox" Grid.Column="1" Content="只顯示有次數的項目" VerticalAlignment="Center"
                                  Checked="UsedOnly_Changed" Unchecked="UsedOnly_Changed"/>
                    </Grid>

                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" FrozenColumnCount="3"
                              PreviewKeyDown="ItemsGrid_PreviewKeyDown" PreviewTextInput="ItemsGrid_PreviewTextInput"
                              VirtualizingPanel.IsVirtualizing="True"/>

                    <TextBlock x:Name="NoDataHint" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddItemButton" Click="AddItem_Click" AutomationProperties.Name="新增項目" ToolTip="在這個月加一個服務項目">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0"/>
                                <TextBlock Text="新增項目"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="小計" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SubtotalText" Text="0" FontWeight="SemiBold" Margin="6,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RatioText" Text="× 0.6" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="實領" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetPayText" Text="0" Foreground="{DynamicResource AccentTextBrush}" FontSize="20"
                                               FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 下方：狀態列 ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- 字體大小：Ctrl + / Ctrl − / Ctrl 0，或按住 Ctrl 滾滑鼠滾輪 -->
                <TextBlock Text="字體" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Button x:Name="ZoomOutButton" Style="{StaticResource GhostButton}" Click="ZoomOut_Click" Padding="8,6"
                        AutomationProperties.Name="縮小字體" ToolTip="縮小字體（Ctrl −）">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" FontSize="12"/>
                </Button>
                <Button x:Name="ZoomResetButton" Style="{StaticResource GhostButton}" Click="ZoomReset_Click" Padding="6,6" FontSize="12"
                        MinWidth="48" AutomationProperties.Name="字體大小" ToolTip="恢復 100%（Ctrl 0）">
                    <TextBlock x:Name="ZoomText" Text="100%"/>
                </Button>
                <Button x:Name="ZoomInButton" Style="{StaticResource GhostButton}" Click="ZoomIn_Click" Padding="8,6"
                        AutomationProperties.Name="放大字體" ToolTip="放大字體（Ctrl +）">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="12"/>
                </Button>
                <Border Width="1" Background="{DynamicResource LineBrush}" Margin="8,6"/>
                <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Click="Theme_Click" Padding="10,6" FontSize="12"
                        AutomationProperties.Name="切換主題">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ThemeText" Text="跟隨系統"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource LineBrush}" Margin="8,6"/>
                <Button Style="{StaticResource GhostButton}" Click="Shortcut_Click" AutomationProperties.Name="桌面捷徑" Padding="10,6" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="桌面捷徑"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click" AutomationProperties.Name="檢查更新" Padding="10,6" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="檢查更新"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
