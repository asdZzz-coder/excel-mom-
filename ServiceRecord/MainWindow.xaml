<Window x:Class="ServiceRecord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ServiceRecord"
        Title="居服紀錄表" Width="1560" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="16"
        Foreground="{DynamicResource TextBrush}"
        Icon="Assets/app.ico"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <!-- 表格最右邊的刪除鈕 -->
        <DataTemplate x:Key="DeleteCellTemplate">
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="DeleteItem_Click"
                    ToolTip="從這個月刪除這個項目" Focusable="False"/>
        </DataTemplate>

        <!-- 代班清單：每一位都是暖橘色的卡片，選到時顏色加深＋左邊橘色條＋框 -->
        <Style x:Key="SubstituteItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,4,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="12" Padding="12,10" Background="{DynamicResource SubstituteSoftBrush}"
                                    BorderBrush="{DynamicResource SubstituteSoftBrush}" BorderThickness="2">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Bar" Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Background="{DynamicResource SubstituteBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubstituteSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubstituteSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SubstituteBrush}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 代班明細：放假日的日期用紅字 -->
        <Style x:Key="DetailDateText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOffDay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="LeftText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- 每天的次數：粗一點，老花也看得清楚 -->
        <Style x:Key="DayText" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CountText" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>

        <!-- 十字標示：選到某一格時，同一列（服務項目）和同一欄（日期）上淡黃底色 -->
        <Style x:Key="CrossCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <!-- 整欄（日期）的底色在程式裡每個日期欄各加一個觸發條件（ItemRow.CrossDay = 這一天） -->
                <DataTrigger Binding="{Binding IsCrossRow}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CrossBrush}"/>
                </DataTrigger>
                <!-- 十字交叉的那一格：選取色＋粗框（放最後才會蓋過上面的底色） -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CellSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="2,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WeekendCell" TargetType="DataGridCell" BasedOn="{StaticResource CrossCell}">
            <Setter Property="Background" Value="{DynamicResource WeekendBrush}"/>
        </Style>
        <Style x:Key="TotalCell" TargetType="DataGridCell" BasedOn="{StaticResource CrossCell}">
            <Setter Property="Background" Value="{DynamicResource TotalBrush}"/>
        </Style>
        <!-- 十字標示的日期標題：較深的黃底＋底線 -->
        <Style x:Key="CrossHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Column.(local:CrossHair.IsActive), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CrossHeaderBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CrossLineBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,12,20,10" LayoutTransform="{DynamicResource UiScale}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 上方：月份切換 + 主要按鈕 ===== -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Click="PrevMonth_Click" ToolTip="上個月" AutomationProperties.Name="上個月" Padding="10,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;"/>
                </Button>
                <TextBlock x:Name="MonthText" Text="2026 年 6 月" FontFamily="{StaticResource DisplayFont}"
                           FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" MinWidth="170"
                           TextAlignment="Center"/>
                <Button Style="{StaticResource GhostButton}" Click="NextMonth_Click" ToolTip="下個月" AutomationProperties.Name="下個月" Padding="10,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;"/>
                </Button>
                <Button Content="本月" Click="ThisMonth_Click" Margin="8,0,0,0" Padding="12,6"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Import_Click" AutomationProperties.Name="匯入 Excel" Margin="0,0,8,0" ToolTip="讀入原本的 Excel 服務紀錄表">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Margin="0,0,8,0"/>
                        <TextBlock Text="匯入 Excel"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="Export_Click" AutomationProperties.Name="匯出 Excel" Margin="0,0,8,0" ToolTip="把這個月匯出成服務紀錄表 Excel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" Margin="0,0,8,0"/>
                        <TextBlock Text="匯出 Excel"/>
                    </StackPanel>
                </Button>
                <Button Click="Settings_Click" AutomationProperties.Name="設定" ToolTip="個案、服務項目、比例">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0"/>
                        <TextBlock Text="設定"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 中間：左側個案清單 + 右側服務紀錄表 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="個案" Style="{StaticResource FieldLabel}" Margin="6,2,0,8"/>
                    <ListBox x:Name="ClientList" Grid.Row="1" Style="{StaticResource EntryListStyle}"
                             SelectionChanged="ClientList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0">
                                        <Run Text="實領"/>
                                        <Run Text="{Binding NetPayText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoClientHint" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                               FontSize="15" Margin="6,4" Visibility="Collapsed"
                               Text="這個月還沒有個案。&#x0a;&#x0a;按右上角「設定」新增個案，或用「匯入 Excel」讀入原本的服務紀錄表。"/>

                    <!-- 代班：跟正常個案分開，只屬於這個月 -->
                    <Grid Grid.Row="2" Margin="0,10,0,6">
                        <Border Height="1" Background="{DynamicResource LineBrush}" VerticalAlignment="Top" Margin="0,0,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource SubstituteBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="代班" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SubstituteTextBrush}"/>
                            </StackPanel>
                            <Button x:Name="AddSubstituteButton" Grid.Column="1" Click="AddSubstitute_Click" Padding="10,5" FontSize="14"
                                    AutomationProperties.Name="新增代班" ToolTip="加一位這個月的代班個案（不會加到設定的個案名單）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="新增代班"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                    <ListBox x:Name="SubstituteList" Grid.Row="3" Style="{StaticResource EntryListStyle}" MaxHeight="250"
                             ItemContainerStyle="{StaticResource SubstituteItem}"
                             SelectionChanged="ClientList_SelectionChanged" AutomationProperties.Name="代班個案">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Info}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SubstituteTextBrush}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Info}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Info}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0">
                                        <Run Text="實領"/>
                                        <Run Text="{Binding NetPayText, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource SubstituteTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoSubstituteHint" Grid.Row="3" Text="這個月沒有代班。" FontSize="14"
                               Foreground="{DynamicResource MutedBrush}" Margin="6,0,6,4"/>

                    <Border Grid.Row="4" Background="{DynamicResource AccentGradient}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="本月月薪" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MonthlyPayText" Text="0" Foreground="White" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="32" FontWeight="Bold" Margin="0,2,0,0"/>
                            <!-- 有代班時分開列出：個案合計、代班合計 -->
                            <Grid x:Name="PayBreakdown" Margin="0,4,0,2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="個案合計" Foreground="White" FontSize="15"/>
                                <TextBlock x:Name="RegularPayText" Grid.Column="1" Text="0" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="代班合計" Foreground="White" FontSize="15" Margin="0,2,0,0"/>
                                <TextBlock x:Name="SubstitutePayText" Grid.Row="1" Grid.Column="1" Text="0" Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </Grid>
                            <TextBlock x:Name="RatioHintText" Foreground="White" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- 代班個案：標題前面加「代班」標籤 -->
                                <Border x:Name="SubstituteBadge" Background="{DynamicResource SubstituteSelectedBrush}" BorderBrush="{DynamicResource SubstituteBrush}" BorderThickness="1.5" CornerRadius="6" Padding="8,2"
                                        Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="代班" Foreground="{DynamicResource SubstituteTextBrush}" FontWeight="Bold" FontSize="16"/>
                                </Border>
                                <TextBlock x:Name="ClientTitle" FontSize="21" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                            </StackPanel>
                            <TextBlock x:Name="SubstituteInfoText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SubstituteTextBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,3,0,0"
                                       Text="點格子直接打數字，Enter 往下一格；選好格子按 + / − 加減一次，Delete 清除。"/>
                            <TextBlock x:Name="HolidayText" Foreground="{DynamicResource DangerBrush}" FontSize="14" FontWeight="SemiBold"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel x:Name="SubstituteActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,16,0" Visibility="Collapsed">
                            <Button Click="EditSubstitute_Click" Padding="10,5" FontSize="14" Margin="0,0,8,0"
                                    AutomationProperties.Name="修改代班" ToolTip="修改這位代班個案的姓名、地點、原居服員、備註">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="修改代班"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Click="DeleteSubstitute_Click" Padding="10,5" FontSize="14"
                                    AutomationProperties.Name="刪除代班" ToolTip="從這個月刪除這位代班個案">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="刪除代班"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <CheckBox x:Name="UsedOnlyBox" Grid.Column="2" Content="只顯示有次數的項目" VerticalAlignment="Center"
                                  Checked="UsedOnly_Changed" Unchecked="UsedOnly_Changed"/>
                    </Grid>

                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" FrozenColumnCount="3"
                              CellStyle="{StaticResource CrossCell}" ColumnHeaderStyle="{StaticResource CrossHeader}"
                              CurrentCellChanged="ItemsGrid_CurrentCellChanged" InputMethod.IsInputMethodEnabled="False"
                              PreviewKeyDown="ItemsGrid_PreviewKeyDown" PreviewTextInput="ItemsGrid_PreviewTextInput"
                              VirtualizingPanel.IsVirtualizing="True"/>

                    <TextBlock x:Name="NoDataHint" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>

                    <!-- 代班明細：選到代班個案時，依日期列出做了哪些服務、單價、次數、金額 -->
                    <Border x:Name="DetailPanel" Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="12" Visibility="Collapsed"
                            Background="{DynamicResource SubstituteSoftBrush}" BorderBrush="{DynamicResource SubstituteBrush}" BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;" Foreground="{DynamicResource SubstituteTextBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="代班明細" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SubstituteTextBrush}"/>
                                <TextBlock x:Name="DetailSummaryText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SubstituteTextBrush}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid x:Name="DetailGrid" Grid.Row="1" MaxHeight="210" IsReadOnly="True" AutoGenerateColumns="False" AutomationProperties.Name="代班明細表"
                                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="104" ElementStyle="{StaticResource DetailDateText}"/>
                                    <DataGridTextColumn Header="代碼" Binding="{Binding Code}" Width="74" ElementStyle="{StaticResource LeftText}"/>
                                    <DataGridTextColumn Header="服務項目（工作內容）" Binding="{Binding Name}" Width="*" MinWidth="180" ElementStyle="{StaticResource LeftText}"/>
                                    <DataGridTextColumn Header="單價" Binding="{Binding Price}" Width="80" ElementStyle="{StaticResource RightText}"/>
                                    <DataGridTextColumn Header="次數" Binding="{Binding Count}" Width="64" ElementStyle="{StaticResource CountText}"/>
                                    <DataGridTextColumn Header="金額" Binding="{Binding AmountText}" Width="100" ElementStyle="{StaticResource RightText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="DetailEmptyText" Grid.Row="1" FontSize="15" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                       Margin="2,0,0,2" Text="還沒有填代班的次數。在上面的表格填好後，這裡會依日期列出代班的工作內容、單價和金額。"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddItemButton" Click="AddItem_Click" AutomationProperties.Name="新增項目" ToolTip="在這個月加一個服務項目">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0"/>
                                <TextBlock Text="新增項目"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="小計" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SubtotalText" Text="0" FontWeight="SemiBold" Margin="6,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RatioText" Text="× 0.6" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="實領" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetPayText" Text="0" Foreground="{DynamicResource AccentTextBrush}" FontSize="24"
                                               FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 下方：狀態列 ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- 字體大小：Ctrl + / Ctrl − / Ctrl 0，或按住 Ctrl 滾滑鼠滾輪 -->
                <TextBlock Text="字體" Foreground="{DynamicResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <Button x:Name="ZoomOutButton" Style="{StaticResource GhostButton}" Click="ZoomOut_Click" Padding="8,6"
                        AutomationProperties.Name="縮小字體" ToolTip="縮小字體（Ctrl −）">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" FontSize="14"/>
                </Button>
                <Button x:Name="ZoomResetButton" Style="{StaticResource GhostButton}" Click="ZoomReset_Click" Padding="6,6" FontSize="14"
                        MinWidth="48" AutomationProperties.Name="字體大小" ToolTip="恢復 100%（Ctrl 0）">
                    <TextBlock x:Name="ZoomText" Text="100%"/>
                </Button>
                <Button x:Name="ZoomInButton" Style="{StaticResource GhostButton}" Click="ZoomIn_Click" Padding="8,6"
                        AutomationProperties.Name="放大字體" ToolTip="放大字體（Ctrl +）">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="14"/>
                </Button>
                <Border Width="1" Background="{DynamicResource LineBrush}" Margin="8,6"/>
                <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Click="Theme_Click" Padding="10,6" FontSize="14"
                        AutomationProperties.Name="切換主題">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ThemeText" Text="跟隨系統"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource LineBrush}" Margin="8,6"/>
                <Button Style="{StaticResource GhostButton}" Click="Shortcut_Click" AutomationProperties.Name="桌面捷徑" Padding="10,6" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="桌面捷徑"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click" AutomationProperties.Name="檢查更新" Padding="10,6" FontSize="14">
                    <StackPanel Orientation="Horizontal">
