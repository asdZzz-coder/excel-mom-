<Window x:Class="ServiceRecord.SubstituteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增代班" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="16"
        Foreground="{DynamicResource TextBrush}">

    <StackPanel Margin="22" LayoutTransform="{DynamicResource UiScale}">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,0,0,14"/>

        <StackPanel x:Name="HistoryPanel">
            <TextBlock Text="以前代過班的個案（也可以不選，直接填下面）" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="HistoryBox" SelectionChanged="HistoryBox_SelectionChanged" Margin="0,0,0,16"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="個案姓名" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="服務地點（可不填）" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="LocationBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="原居服員（替誰代班，可不填）" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
        <TextBox x:Name="CoverForBox"/>

        <TextBlock Text="備註（例如代班期間，可不填）" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
        <TextBox x:Name="NoteBox"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="新增" IsDefault="True" Click="Ok_Click" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
